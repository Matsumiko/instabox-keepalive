# instabox API key and targets. Copy to .env and fill in; never commit .env.

# Required. Create at https://dashboard.instabox.sh/dashboard/api-keys
# Scope: machines:write (it includes machines:read).
INSTABOX_API_KEY=ibk_replace_me

# Optional. Comma-separated machine IDs (m_...) or names. Empty keeps every
# machine the key can see.
MACHINES=fadz-1

# Optional. Lease name and lifetime in seconds (30-3600). TTL should be at least
# three times the interval you run this at.
LEASE=keepalive
TTL=900

# Optional. Seconds between rounds for `watch` (minimum 60).
INTERVAL=300

# Optional. Point at another deployment (self-hosted instabox).
# INSTABOX_API_URL=https://api.instabox.sh

# Optional. Log what would happen without waking or renewing anything.
# DRY_RUN=1
